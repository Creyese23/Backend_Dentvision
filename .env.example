# ============================================================
# Dentvision Backend — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA comitas el .env real al repositorio.
# ============================================================

# ---- Servidor ----
SERVER_PORT=8080

# ---- Base de datos MySQL (desarrollo) ----
SPRING_PROFILES_ACTIVE=mysql-dev
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dentvision_db
DB_USERNAME=root
DB_PASSWORD=tu_password_aqui

# ---- JWT ----
# Genera una clave segura con: openssl rand -base64 32
JWT_SECRET=<BASE64_KEY_DE_AL_MENOS_32_BYTES>
JWT_EXPIRATION_MS=900000        # 15 minutos para access token
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 dias para refresh token

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- JPA ----
# "validate" en produccion con Flyway; "update" en dev sin Flyway
JPA_DDL_AUTO=validate
